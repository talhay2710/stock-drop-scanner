# סודות/הגדרות אישיות - לא לשתף (יש טוקן טלגרם אמיתי בקובץ הזה)
config.yaml

# scanner.log לא נכנס (לא קוד, אין ערך בהיסטוריית גרסאות), אבל alerts.db כן
# עכשיו כן נכנס לגיט בכוונה - זה מקור האמת המשותף בין GitHub Actions
# (שכותב אליו) ל-Streamlit Cloud (שקורא ממנו), ה-Actions מבצע commit רק
# כשיש שינוי אמיתי (לא כל ריצה), אז הגידול בהיסטוריה נשאר קטן.
scanner.log
*.log

# קבצים שנוצרים אוטומטית, לא רלוונטיים ל-git
__pycache__/
*.pyc
# רק credentials.toml (מקומי-למכונה, נוצר אוטומטית) - לא כל התיקייה, כי
# config.toml כן צריך להידחף (fileWatcherType, ר' הערה שם - חלק מתיקון
# ה-thread leak בענן, 17.9.2026).
.streamlit/credentials.toml

# מצב מקומי של desktop_notify_watcher.py (איזו התראה/סיכום כבר הוצג
# כ-toast במחשב הזה) - ספציפי למכונה, לא משהו לשתף
.desktop_notify_state.json
